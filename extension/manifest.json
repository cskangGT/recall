{
  "manifest_version": 3,
  "name": "Recall",
  "version": "0.1.0",
  "description": "Save the page you are reading to Recall, without leaving it.",

  "permissions": ["activeTab", "scripting", "notifications"],

  "host_permissions": ["http://127.0.0.1:5170/*"],

  "background": { "service_worker": "src/background.js", "type": "module" },

  "action": {
    "default_title": "Save this page to Recall",
    "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png" }
  },

  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },

  "commands": {
    "save-page": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Save this page to Recall"
    }
  }
}
