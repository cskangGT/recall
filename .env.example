# Copy to .env.local and fill in. .env.local is gitignored.
#
# Both must be set or the server stays on the fixture provider — half-live
# (real embeddings, scripted names) fails in ways that are hard to spot.

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Google Calendar → meetings. Both must be set or the door stays undrawn.
# Make an OAuth client (Web application) at console.cloud.google.com with the
# Calendar API enabled, and register the redirect URI exactly as
#   http://127.0.0.1:5170/api/google/callback        (npm start)
#   http://127.0.0.1:5174/api/google/callback        (npm run dev:api)
# GOOGLE_REDIRECT_URI overrides the derived one for a hosted deployment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
