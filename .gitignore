node_modules
dist

# Claude Code's scratch space, including git worktrees. A worktree is a repo
# inside the repo; committing one produces a directory nobody can check out.
# One exception, re-included rung by rung (git cannot un-ignore a child of an
# ignored directory): the import-instagram skill is part of the product — it
# is how saved posts get in — so it ships with the checkout.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/import-instagram/
.DS_Store
test-results
playwright-report
*.local

# Generated by scripts/install-agent.mjs into ~/Library/LaunchAgents. It holds
# absolute paths to one machine, so it is never written here — belt and braces.
*.plist

# API keys. *.local

# Generated by scripts/install-agent.mjs into ~/Library/LaunchAgents. It holds
# absolute paths to one machine, so it is never written here — belt and braces.
*.plist already covers .env.local; these are belt and braces.
.env
.env.*
!.env.example
